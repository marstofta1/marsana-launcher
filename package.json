{
  "name": "marsana-launcher",
  "version": "0.1.25",
  "description": "Marsana Minecraft Launcher",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder",
    "pack:mac": "electron-builder --mac",
    "pack:win": "node scripts/embed-logo.js && electron-builder --win",
    "pack:linux": "electron-builder --linux",
    "pack:desktop": "electron-builder --mac --win",
    "verify:release": "node scripts/verify-release-docs.js",
    "mobile:sync": "node scripts/sync-mobile-www.js"
  },
  "build": {
    "appId": "com.marsana.launcher",
    "productName": "Marsana Launcher",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://marstofta1.github.io/marsana-launcher/downloads/"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-mac.dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "${productName}-${version}-linux.AppImage"
    }
  },
  "dependencies": {
    "adm-zip": "^0.4.16",
    "electron-updater": "^6.8.3",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
