{
  "name": "marsana-launcher",
  "version": "0.1.39",
  "description": "Marsana Minecraft Launcher",
  "private": true,
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder",
    "pack:mac": "electron-builder --mac && node scripts/prepare-macos-downloads.js",
    "pack:win": "node scripts/embed-logo.js && node scripts/ensure-client-mod.js && node scripts/ensure-bundled-deps.js && electron-builder --win && node scripts/prepare-windows-downloads.js",
    "pack:linux": "electron-builder --linux && node scripts/prepare-linux-downloads.js",
    "pack:desktop": "electron-builder --mac --win",
    "verify:release": "node scripts/verify-release-docs.js",
    "prepare:win-downloads": "node scripts/prepare-windows-downloads.js",
    "prepare:mac-downloads": "node scripts/prepare-macos-downloads.js",
    "prepare:linux-downloads": "node scripts/prepare-linux-downloads.js",
    "prepare:android-downloads": "node scripts/prepare-android-downloads.js",
    "prepare:ios-downloads": "node scripts/prepare-ios-downloads.js",
    "prepare:downloads": "node scripts/prepare-windows-downloads.js && node scripts/prepare-macos-downloads.js && node scripts/prepare-linux-downloads.js && node scripts/prepare-android-downloads.js && node scripts/prepare-ios-downloads.js",
    "analytics:start": "npm --prefix analytics-server start",
    "version:resolve": "node scripts/resolve-release-version.js",
    "mobile:sync": "node scripts/sync-mobile-www.js",
    "build:client-mod": "cd marsana-client-mod && gradlew.bat build copyToBundled"
  },
  "build": {
    "appId": "com.marsana.launcher",
    "productName": "Marsana Launcher",
    "files": [
      "src/**/*",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "bundled-mods",
        "to": "bundled-mods",
        "filter": ["**/*"]
      },
      {
        "from": "analytics-config.json",
        "to": "analytics-config.json"
      }
    ],
    "directories": {
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://marstofta1.github.io/marsana-launcher/downloads/"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        }
      ],
      "category": "public.app-category.games",
      "artifactName": "${productName}-${version}-mac.dmg"
    },
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-${version}-${os}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game",
      "artifactName": "${productName}-${version}-linux.AppImage"
    }
  },
  "dependencies": {
    "adm-zip": "^0.4.16",
    "electron-updater": "^6.8.3",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^4.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  }
}
