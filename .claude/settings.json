{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(& \"C:\\Program Files\\Git\\cmd\\git.exe\" *)",
      "PowerShell(& 'C:\\Program Files\\Git\\cmd\\git.exe' *)",
      "PowerShell($git*)",
      "PowerShell(git *)",
      "PowerShell(npm install --omit=dev --no-audit --no-fund 2>&1)",
      "PowerShell(node \"C:\\\\Users\\\\alper\\\\AppData\\\\Local\\\\Temp\\\\claude\\\\c--Users-alper-OneDrive-Masa-st--Desktop-marsana-launcher-main\\\\066ac35e-ab23-414b-83ea-4579b12c0c8a\\\\scratchpad\\\\k2test.js\")",
      "PowerShell(git fetch origin --quiet)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$ErrorActionPreference='SilentlyContinue'; $g='C:\\Program Files\\Git\\cmd\\git.exe'; if (-not (Test-Path $g)) { $g='git' }; & $g add -A 2>$null | Out-Null; & $g diff --cached --quiet 2>$null; if ($LASTEXITCODE -eq 1) { & $g commit -m 'otomatik revize' 2>$null | Out-Null; & $g push origin main 2>$null | Out-Null }",
            "shell": "powershell",
            "timeout": 60,
            "statusMessage": "Otomatik commit + push main",
            "async": true
          }
        ]
      }
    ]
  }
}
